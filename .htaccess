# Serve index.html for directory URLs (e.g. /swayze/ -> /swayze/index.html).
<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

# ---------------------------------------------------------------------------
# Cache policy for compassclaw.com
#
# LiteSpeed serves static assets with `Cache-Control: public, max-age=604800`
# (7 days) by default. After a deploy, a returning visitor revalidates
# index.html but reuses their cached styles.css -- so they render the NEW html
# against the OLD stylesheet and the layout breaks for up to a week.
#
# Every directive below is wrapped in <IfModule>, so if a module is missing the
# file is a no-op (current behaviour) rather than a 500.
# ---------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML must always revalidate: it is what links the assets.
  ExpiresByType text/html               "access plus 0 seconds"

  # Assets: cacheable, but revalidated hourly so a deploy reaches users fast.
  # NOTE: LiteSpeed labels JS as `text/javascript` (not application/javascript).
  ExpiresByType text/css                "access plus 1 hour"
  ExpiresByType text/javascript         "access plus 1 hour"
  ExpiresByType application/javascript  "access plus 1 hour"
  ExpiresByType text/plain              "access plus 1 hour"
  ExpiresByType application/json        "access plus 1 hour"
  ExpiresByType application/xml         "access plus 1 hour"

  # Binary media: safe to keep longer.
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 month"
  ExpiresByType application/pdf         "access plus 1 week"
  ExpiresByType audio/mpeg              "access plus 1 week"
</IfModule>
