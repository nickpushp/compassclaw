# Block direct web access to secrets. LiteSpeed honors this.
<Files "config.php">
    Require all denied
</Files>

<Files "secrets.php">
    Require all denied
</Files>

# Belt-and-suspenders for older Apache/LiteSpeed auth directives.
<FilesMatch "(config|secrets)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>
